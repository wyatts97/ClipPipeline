 CLIP_RETRY_PAUSE_SECONDS = float(os.environ.get("CLIP_RETRY_PAUSE_SECONDS", "10"))
 
 
+def preset_clips(video_duration):
+    """Clips the caller already chose (PRESET_CLIPS, set by /api/process from preset_clips):
+    cut as given instead of asking the model, clamped to the video. None when there are none."""
+    raw = os.environ.get("PRESET_CLIPS", "").strip()
+    if not raw:
+        return None
+    try:
+        items = json.loads(raw)
+    except ValueError:
+        print("⚠️ PRESET_CLIPS isn't valid JSON — picking clips as usual.")
+        return None
+    clips = []
+    for c in items if isinstance(items, list) else []:
+        try:
+            start, end = float(c["start"]), float(c["end"])
+        except (KeyError, TypeError, ValueError):
+            continue
+        start = max(0.0, start)
+        end = min(float(video_duration), end) if video_duration else end
+        if end - start >= 1.0:
+            clips.append({**c, "start": round(start, 3), "end": round(end, 3)})
+    return clips or None
+
