{
  "id": "clippipelineTg01",
  "name": "ClipPipeline - Telegram approval",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},
  "nodes": [
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000001",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-260, -360],
      "parameters": {
        "width": 620,
        "height": 260,
        "content": "## ClipPipeline - Telegram approval\n**Top:** every Telegram update. Text goes to clipbot `/messages` (it parses links, ranges, `/scan`, `/watch`, `/status`, and ignores chats not in `ALLOWED_CHAT_IDS`). Button taps go to clipbot `/decisions`: ✅/❌ move a clip to `data/approved/` or `data/rejected/`, 🎬 turns a scanned moment into a clip job.\n\n**Bottom:** clipbot posts events here. `clip_ready` = preview video with ✅ Post / ❌ Skip, `message` = plain text, `choice` = a scanned moment with 🎬 buttons.\n\nPublishing hooks in after **Send decision reply**."
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000002",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [-260, 0],
      "webhookId": "__TELEGRAM_WEBHOOK_ID__",
      "parameters": {
        "updates": ["message", "callback_query"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000003",
      "name": "Button press?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-40, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1b2c3d4-0000-4000-8000-000000000001",
              "leftValue": "={{ !!$json.callback_query }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000004",
      "name": "Clipbot: decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, -120],
      "parameters": {
        "method": "POST",
        "url": "__CLIPBOT_URL__/decisions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.callback_query.message.chat.id, data: $json.callback_query.data }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "__TOKEN_CREDENTIAL_ID__", "name": "ClipBot token" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000005",
      "name": "Answer button",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [400, -120],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Telegram Trigger').item.json.callback_query.id }}",
        "additionalFields": { "text": "={{ $('Clipbot: decision').item.json.toast }}" }
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000006",
      "name": "Decision reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [620, -120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1b2c3d4-0000-4000-8000-000000000002",
              "leftValue": "={{ !!$('Clipbot: decision').item.json.reply }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000007",
      "name": "Send decision reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [840, -140],
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.callback_query.message.chat.id }}",
        "text": "={{ $('Clipbot: decision').item.json.reply }}",
        "additionalFields": {
          "appendAttribution": false,
          "reply_to_message_id": "={{ $('Telegram Trigger').item.json.callback_query.message.message_id }}"
        }
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000008",
      "name": "Clipbot: message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 120],
      "parameters": {
        "method": "POST",
        "url": "__CLIPBOT_URL__/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.message.chat.id, text: $json.message.text || $json.message.caption || '' }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "__TOKEN_CREDENTIAL_ID__", "name": "ClipBot token" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000009",
      "name": "Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [400, 120],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1b2c3d4-0000-4000-8000-000000000003",
              "leftValue": "={{ !!$json.reply }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-00000000000a",
      "name": "Send reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [620, 100],
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $('Clipbot: message').item.json.reply }}",
        "additionalFields": { "appendAttribution": false, "disable_web_page_preview": true }
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-00000000000b",
      "name": "Clipbot events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 420],
      "webhookId": "__EVENTS_WEBHOOK_ID__",
      "parameters": {
        "httpMethod": "POST",
        "path": "clipbot-events",
        "authentication": "headerAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "__TOKEN_CREDENTIAL_ID__", "name": "ClipBot token" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-00000000000c",
      "name": "Event type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-40, 420],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  {
                    "id": "c1b2c3d4-0000-4000-8000-000000000004",
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "clip_ready",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "clip_ready"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  {
                    "id": "c1b2c3d4-0000-4000-8000-000000000005",
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "message",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "message"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
                "conditions": [
                  {
                    "id": "c1b2c3d4-0000-4000-8000-000000000006",
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "choice",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "choice"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-00000000000d",
      "name": "Download preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 340],
      "parameters": {
        "url": "={{ $json.body.preview_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "__TOKEN_CREDENTIAL_ID__", "name": "ClipBot token" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-00000000000e",
      "name": "Send clip",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [400, 340],
      "parameters": {
        "operation": "sendVideo",
        "chatId": "={{ $('Clipbot events').item.json.body.chat_id }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Post",
                    "additionalFields": { "callback_data": "={{ $('Clipbot events').item.json.body.approve_data }}" }
                  },
                  {
                    "text": "❌ Skip",
                    "additionalFields": { "callback_data": "={{ $('Clipbot events').item.json.body.skip_data }}" }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": { "caption": "={{ $('Clipbot events').item.json.body.caption }}" }
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-00000000000f",
      "name": "Send message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [180, 520],
      "parameters": {
        "chatId": "={{ $json.body.chat_id }}",
        "text": "={{ $json.body.text }}",
        "additionalFields": { "appendAttribution": false, "disable_web_page_preview": true }
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    },
    {
      "id": "6f0e7b2a-1c11-4d61-9a01-000000000010",
      "name": "Send choice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [180, 700],
      "parameters": {
        "chatId": "={{ $json.body.chat_id }}",
        "text": "={{ $json.body.text }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "={{ $json.body.buttons[0].text }}",
                    "additionalFields": { "callback_data": "={{ $json.body.buttons[0].data }}" }
                  },
                  {
                    "text": "={{ $json.body.buttons[1].text }}",
                    "additionalFields": { "callback_data": "={{ $json.body.buttons[1].data }}" }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": { "appendAttribution": false, "disable_web_page_preview": true }
      },
      "credentials": {
        "telegramApi": { "id": "__TELEGRAM_CREDENTIAL_ID__", "name": "ClipBot Telegram" }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Button press?", "type": "main", "index": 0 }]] },
    "Button press?": {
      "main": [
        [{ "node": "Clipbot: decision", "type": "main", "index": 0 }],
        [{ "node": "Clipbot: message", "type": "main", "index": 0 }]
      ]
    },
    "Clipbot: decision": { "main": [[{ "node": "Answer button", "type": "main", "index": 0 }]] },
    "Answer button": { "main": [[{ "node": "Decision reply?", "type": "main", "index": 0 }]] },
    "Decision reply?": { "main": [[{ "node": "Send decision reply", "type": "main", "index": 0 }], []] },
    "Clipbot: message": { "main": [[{ "node": "Reply?", "type": "main", "index": 0 }]] },
    "Reply?": { "main": [[{ "node": "Send reply", "type": "main", "index": 0 }], []] },
    "Clipbot events": { "main": [[{ "node": "Event type", "type": "main", "index": 0 }]] },
    "Event type": {
      "main": [
        [{ "node": "Download preview", "type": "main", "index": 0 }],
        [{ "node": "Send message", "type": "main", "index": 0 }],
        [{ "node": "Send choice", "type": "main", "index": 0 }]
      ]
    },
    "Download preview": { "main": [[{ "node": "Send clip", "type": "main", "index": 0 }]] }
  }
}
