# Copy to .env with scripts/init-env.sh (it also fills in the random secrets).

# ---- Required: fill these in ------------------------------------------------
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Gemini API key (https://aistudio.google.com/apikey). Picks the moments and the layout.
GEMINI_API_KEY=
# Hostname your Cloudflare Tunnel routes to n8n, e.g. clips.example.com (no https://).
PUBLIC_HOSTNAME=
# Your Telegram chat id. Leave empty at first: the bot answers /start with it.
ALLOWED_CHAT_IDS=

# ---- Generated by scripts/init-env.sh (don't share) -------------------------
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
CLIPBOT_TOKEN=
# Password for the web dashboard (http://<server-ip>:8090). Change it to anything you like.
DASHBOARD_PASSWORD=
# Signs Postiz logins (publishing).
POSTIZ_JWT_SECRET=

# ---- Clip settings ------------------------------------------------------------
TARGET_CLIPS=3
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
# OpenShorts layouts: auto (Gemini picks per video), or any of
# screencast (screen/gameplay over the speaker), split, speaker_cut, punch_in, none.
OPENSHORTS_LAYOUTS=auto
# Burn the AI hook line on the clip / burn word-by-word captions.
AUTO_HOOK=true
CAPTIONS=true
# Longest time range (minutes) you can ask for in one message.
MAX_RANGE_MINUTES=90
# Retry a failed job once, 2-5 minutes later, when the cause was passing (network drop,
# Gemini overloaded or rate-limited).
AUTO_RETRY=true

# ---- /scan and /watch -------------------------------------------------------------
# How many moments a scan sends, and the clip window around each peak
# (chat reacts after the moment, so the window starts well before it).
SCAN_TOP=5
SCAN_BEFORE_SECONDS=90
SCAN_AFTER_SECONDS=45
# Clips per 🎬 tap (➕ Wider always makes 2 from a window 1 minute longer on each side).
SCAN_CLIPS_PER_MOMENT=1
# Read audio loudness too. Costs a download of the audio (Kick: the 160p video).
SCAN_AUDIO=true
# Extra words/emotes that count as hype, comma separated, e.g. a streamer's own emotes.
SCAN_HYPE_WORDS=
# How often watched channels are checked for a finished stream.
WATCH_INTERVAL_MINUTES=15
# Optional, free at https://dev.twitch.tv/console/apps: adds Twitch viewer clips to scans.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Publishing (bash setup.sh --publish fills these in) --------------------------
# Postiz posts approved clips. Turn it on with COMPOSE_PROFILES=publish (or tunnel,publish).
# Its own hostname, routed by your tunnel to http://localhost:4007 (no https://).
POSTIZ_HOSTNAME=
# Postiz → Settings → Public API. Empty = ✅ Post only moves the clip to approved/.
POSTIZ_API_KEY=
# Times of day (in TZ) approved clips go out, one clip per time, next free one first.
PUBLISH_SLOTS=12:00,17:00,21:00
# Which connected Postiz channels get each clip: youtube, tiktok, instagram.
PUBLISH_TO=youtube,tiktok,instagram
# UPLOAD = the clip lands in your TikTok drafts (add a sound, post it in the app);
# DIRECT_POST = Postiz publishes it (private until TikTok has audited your app).
TIKTOK_POST_MODE=UPLOAD
# public, unlisted or private. Uploads stay private until Google has audited your project.
YOUTUBE_VISIBILITY=public
# Your developer apps (README → Publishing). Redirect URLs: https://<POSTIZ_HOSTNAME>/integrations/social/<youtube|tiktok|instagram-standalone>
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Server ------------------------------------------------------------------
TZ=UTC
# Owner of ./data on the host (run `id` to check).
PUID=1000
PGID=1000
# Interface for the LAN pages: dashboard (8090), n8n editor (5678), optional OpenShorts UI (5175).
# Set to this server's LAN IP to keep them off other interfaces.
N8N_BIND=0.0.0.0
# Whisper model on CPU: base is ~2x faster than small, small is more accurate.
WHISPER_MODEL=small
OPENSHORTS_CONCURRENT_JOBS=1

# ---- Optional ----------------------------------------------------------------
# Dashboard port on the LAN (default 8090).
# DASHBOARD_PORT=8090
# n8n API key (n8n > Settings > n8n API): lets the dashboard list failed workflow runs.
# N8N_API_KEY=
# Only with the bundled tunnel container: set COMPOSE_PROFILES=tunnel and the tunnel's token
# (Zero Trust > Networks > Tunnels > your tunnel). setup.sh sets both for you.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
# GEMINI_MODEL=
# Moment picking on your own OpenAI-compatible server instead of Gemini:
# LLM_BASE_URL=http://192.168.1.50:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# Netscape-format YouTube cookies if YouTube asks OpenShorts to "confirm you're not a bot":
# YOUTUBE_COOKIES=
# Pinned image versions:
# N8N_VERSION=2.43.7
# CLOUDFLARED_VERSION=2026.10.0
# POSTIZ_VERSION=v2.25.0
# TEMPORAL_VERSION=1.28.1
